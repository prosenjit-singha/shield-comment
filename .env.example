# Root env for docker compose (copy to .env to override defaults)
POSTGRES_USER=shield
POSTGRES_PASSWORD=shield
POSTGRES_DB=shield_comment
POSTGRES_HOST_PORT=5432
# WSL already runs a local redis on 6379. If Docker says the port is taken, use 6380.
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://admin.localhost:5173,http://app.localhost:5174,http://localhost:5173,http://localhost:5174
# admin/ calls same-origin /api (nginx proxies it to backend). Open http://admin.localhost:5173
ADMIN_HOST_PORT=5173
# client/ is a Node SSR server that proxies same-origin /api to backend. Open http://app.localhost:5174
CLIENT_HOST_PORT=5174
# Absolute origin used in canonical/hreflang/og:url tags (prod: https://app.<your-domain>)
CLIENT_PUBLIC_URL=http://app.localhost:5174
# Better Auth (backend). Secret >= 32 chars: `openssl rand -base64 48`
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-48-better-auth
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://admin.localhost:5173,http://app.localhost:5174,http://localhost:5173,http://localhost:5174
# Gate E2E suite (e2e/, optional). Dev-only defaults; the suite only runs against this local stack.
# E2E_SUPER_ADMIN_PASSWORD=e2e-dev-only-Admin-123
# E2E_OWNER_PASSWORD=e2e-dev-only-Owner-123
# Meta connect (optional; compose passes these to the backend only when set, never as empty values).
# Without them the stack starts and Meta connect answers 503. Meanings + formats: backend/.env.example.
# TOKEN_ENCRYPTION_KEY=<openssl rand -base64 32>
# TOKEN_ENCRYPTION_KEY_ID=k1
# TOKEN_ENCRYPTION_PREVIOUS_KEYS=
# META_APP_ID=<numeric app id>
# META_APP_SECRET=<app secret>
# META_LOGIN_CONFIG_ID=<Login for Business configuration id>
# META_OAUTH_REDIRECT_URI=http://app.localhost:5174/api/meta/oauth/callback
# META_GRAPH_API_VERSION=v26.0
#
# Compose runs against the Docker postgres/redis above. For staging/prod the backend gets
# these instead (see backend/.env.example for full samples):
# DATABASE_URL=postgresql://<user>:<password>@ep-<name>-<id>-pooler.ap-southeast-1.aws.neon.tech/<db>?sslmode=require   (Neon pooled, runtime)
# DIRECT_URL=postgresql://<user>:<password>@ep-<name>-<id>.ap-southeast-1.aws.neon.tech/<db>?sslmode=require           (Neon direct, migrate)
# REDIS_URL=redis://default:<password>@redis-<port>.<region>.redns.redis-cloud.com:<port>                              (Redis Cloud, noeviction)
# BETTER_AUTH_URL=https://api.<your-domain>
# TRUSTED_ORIGINS=https://admin.<your-domain>,https://app.<your-domain>
#
# `neon deploy` / `neon env pull` APPEND Neon vars (DATABASE_URL, AWS_*, NEON_*) to this root .env when it exists.
# Move them to backend/.env.neon right away: compose must keep using the Docker postgres above.
# Neon object storage / AI gateway (backend only, optional; see backend/.env.example):
# AWS_ACCESS_KEY_ID=<id>  AWS_SECRET_ACCESS_KEY=<secret>  AWS_ENDPOINT_URL_S3=https://<branch-id>.storage.<region>.aws.neon.tech
# AWS_REGION=ap-southeast-1  STORAGE_BUCKET=assets
# NEON_AI_GATEWAY_BASE_URL=https://<branch-id>-api.ai.<region>.aws.neon.tech  NEON_AI_GATEWAY_TOKEN=nt_live_<token>  AI_GATEWAY_MODEL=typesafeai-jev-1-14-0
