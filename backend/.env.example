NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Local dev (postgres/redis from `docker compose up -d postgres redis`).
# If a local Postgres owns 5432, compose maps Docker Postgres to POSTGRES_HOST_PORT (e.g. 5433): use that port here.
# DATABASE_URL = runtime (pooled in prod). DIRECT_URL = migrations only (drizzle-kit, db:deploy); optional, falls back to DATABASE_URL.
DATABASE_URL=postgresql://shield:shield@localhost:5432/shield_comment?schema=public
DIRECT_URL=postgresql://shield:shield@localhost:5432/shield_comment?schema=public
REDIS_URL=redis://localhost:6379
#
# --- Staging / production samples (Neon free tier, Singapore + Redis Cloud free) ---
# Neon: one branch per environment. Pooled host has `-pooler`; direct host does not.
# DATABASE_URL=postgresql://<user>:<password>@ep-<name>-<id>-pooler.ap-southeast-1.aws.neon.tech/<db>?sslmode=require&channel_binding=require
# DIRECT_URL=postgresql://<user>:<password>@ep-<name>-<id>.ap-southeast-1.aws.neon.tech/<db>?sslmode=require&channel_binding=require
# Redis Cloud free (30 MB): set eviction policy to `noeviction` (BullMQ). Use rediss:// if TLS is enabled.
# REDIS_URL=redis://default:<password>@redis-<port>.<region>.redns.redis-cloud.com:<port>
# BETTER_AUTH_URL=https://api.<your-domain>
# TRUSTED_ORIGINS=https://admin.<your-domain>,https://app.<your-domain>
# CORS_ORIGINS=https://admin.<your-domain>,https://app.<your-domain>
# Comma-separated origins allowed by CORS (admin + client dev servers)
CORS_ORIGINS=http://admin.localhost:5173,http://app.localhost:5174,http://localhost:5173,http://localhost:5174
# Better Auth. Secret >= 32 chars: `openssl rand -base64 48`. URL = public backend URL (no /api/auth).
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-48-better-auth
BETTER_AUTH_URL=http://localhost:3000
# Comma list of app origins allowed to call /api/auth/* (CSRF / redirect checks)
TRUSTED_ORIGINS=http://admin.localhost:5173,http://app.localhost:5174,http://localhost:5173,http://localhost:5174
# Public origin of the client app: impersonation redirectUrl = <CLIENT_APP_URL>/impersonate?token=...
# (default http://app.localhost:5174). Prod: https://app.<your-domain>
CLIENT_APP_URL=http://app.localhost:5174
# Token cipher: AES-256-GCM for Meta user/Page access tokens at rest (optional until the Meta module;
# the cipher is disabled when all three are unset). KEY = base64 of exactly 32 bytes: `openssl rand -base64 32`.
# KEY_ID (A-Z a-z 0-9 _ -, max 32) is stored in every ciphertext `v1:<keyId>:<iv>:<tag>:<ciphertext>`.
# Rotate: move the old pair to PREVIOUS_KEYS (decrypt only, `id:base64,id:base64`), set a new KEY + KEY_ID.
# Never reuse a key id for a different key. Leave the lines commented out instead of empty (empty = invalid).
# TOKEN_ENCRYPTION_KEY=<openssl rand -base64 32>
# TOKEN_ENCRYPTION_KEY_ID=k1
# TOKEN_ENCRYPTION_PREVIOUS_KEYS=
# Meta app (Facebook Login for Business + Graph API; optional, MetaGraphClient is disabled when all four
# are unset; set all four together). Local/staging: the Meta *test app* of the prod app; production: the
# live app (secret only in the host's secret store). Turn on "Require App Secret" in the app's Advanced
# settings: every token call sends appsecret_proof. Redirect URI must match the app's allow-list exactly.
# META_APP_ID=<numeric app id>
# META_APP_SECRET=<app secret>
# META_LOGIN_CONFIG_ID=<Login for Business configuration id>
# META_OAUTH_REDIRECT_URI=http://app.localhost:5174/api/meta/oauth/callback
# Optional: override the pinned Graph API version (default in src/meta/meta-graph.config.ts).
# META_GRAPH_API_VERSION=v26.0
# Only read by `npm run create-super-admin` (after `npm run build`). Idempotent: creates the user, or
# promotes an existing one (its password is kept). Remove the password from .env afterwards.
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME=Super Admin
#
# --- Neon Object Storage + AI Gateway (optional; the services are disabled when unset) ---
# `neon deploy` pulls these into the repo-root .env; move them to git-ignored backend/.env.neon
# (with DATABASE_URL = pooled, DIRECT_URL = DATABASE_URL_UNPOOLED) and run `npm run start:neon` / `neon:smoke` / `db:deploy:neon`.
# Neon `staging` branch: from the repo root run `neon env pull --branch staging --file backend/.env.staging`,
# add DIRECT_URL (= DATABASE_URL_UNPOOLED) + STORAGE_BUCKET, then `npm run start:staging` / `db:deploy:staging` / `neon:smoke:staging`.
# AWS_ACCESS_KEY_ID=<neon-branch-credential-id>
# AWS_SECRET_ACCESS_KEY=<neon-branch-credential-secret>
# AWS_ENDPOINT_URL_S3=https://<branch-id>.storage.<region>.aws.neon.tech
# AWS_REGION=ap-southeast-1
# STORAGE_BUCKET=assets
# NEON_AI_GATEWAY_BASE_URL=https://<branch-id>-api.ai.<region>.aws.neon.tech
# NEON_AI_GATEWAY_TOKEN=nt_live_<token>
# AI_GATEWAY_MODEL=gpt-oss-20b
