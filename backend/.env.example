NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Local dev (postgres/redis from `docker compose up -d postgres redis`).
# If a local Postgres owns 5432, compose maps Docker Postgres to POSTGRES_HOST_PORT (e.g. 5433): use that port here.
DATABASE_URL=postgresql://shield:shield@localhost:5432/shield_comment?schema=public
REDIS_URL=redis://localhost:6379
# Comma-separated origins allowed by CORS (admin + client dev servers)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# JWT (HS256). Two different secrets, each at least 32 chars: `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace-me-with-openssl-rand-base64-48-access
JWT_REFRESH_SECRET=replace-me-with-openssl-rand-base64-48-refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
