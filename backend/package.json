{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --env-file .env --env-file .env.development --env-file .env.local",
    "start:dev": "nest start --watch --env-file .env --env-file .env.development --env-file .env.local",
    "start:debug": "nest start --debug --watch --env-file .env --env-file .env.development --env-file .env.local",
    "start:prod": "node dist/main",
    "start:staging": "NEON_BRANCH=staging node --env-file-if-exists=.env --env-file-if-exists=.env.staging --env-file-if-exists=.env.local --import ./dist/scripts/neon-branch-guard.js dist/main.js",
    "start:production": "NEON_BRANCH=production node --env-file-if-exists=.env --env-file-if-exists=.env.production --env-file-if-exists=.env.local --import ./dist/scripts/neon-branch-guard.js dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:deploy": "node --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.local dist/db/migrate.js",
    "db:deploy:staging": "NEON_BRANCH=staging node --env-file-if-exists=.env --env-file-if-exists=.env.staging --env-file-if-exists=.env.local --import ./dist/scripts/neon-branch-guard.js dist/db/migrate.js",
    "db:deploy:production": "NEON_BRANCH=production node --env-file-if-exists=.env --env-file-if-exists=.env.production --env-file-if-exists=.env.local --import ./dist/scripts/neon-branch-guard.js dist/db/migrate.js",
    "neon:smoke:staging": "NEON_BRANCH=staging node --env-file-if-exists=.env --env-file-if-exists=.env.staging --env-file-if-exists=.env.local --import ./dist/scripts/neon-branch-guard.js dist/scripts/neon-smoke.js",
    "neon:smoke:production": "NEON_BRANCH=production node --env-file-if-exists=.env --env-file-if-exists=.env.production --env-file-if-exists=.env.local --import ./dist/scripts/neon-branch-guard.js dist/scripts/neon-smoke.js",
    "db:studio": "drizzle-kit studio",
    "create-super-admin": "node --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.local dist/scripts/create-super-admin.js",
    "meta:subscribe-pages": "node --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.local dist/scripts/subscribe-active-pages.js",
    "ai:golden": "node --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.local dist/scripts/golden-suite.js",
    "ai:golden:production": "NEON_BRANCH=production node --env-file-if-exists=.env --env-file-if-exists=.env.production --env-file-if-exists=.env.local --import ./dist/scripts/neon-branch-guard.js dist/scripts/golden-suite.js",
    "ai:sdk-smoke": "node --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.local dist/scripts/ai-sdk-smoke.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/s3-request-presigner": "^3.1170.0",
    "@better-auth/core": "^1.7.25",
    "@neon/ai-sdk-provider": "^1.4.0",
    "@neon/config": "^1.14.5",
    "@neon/env": "^2.1.8",
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/drizzle": "^0.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "^6.8.0",
    "@node-rs/argon2": "^2.2.2",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "@typesafe-ai/sdk": "0.7.0",
    "ai": "^7.0.177",
    "better-auth": "^1.7.25",
    "bullmq": "^6.7.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "allowScripts": {}
}
