// ShieldComment BD — Prisma schema. Models are added per module.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Module 1: auth, RBAC, multi-tenancy, impersonation ───────────────────────
// DB names are snake_case (@map / @@map); the generated TS client is camelCase.

enum UserRole {
  SUPER_ADMIN
  USER
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
}

enum WorkspaceMemberRole {
  OWNER
  ADMIN
  MODERATOR
}

/// Better Auth core `user` model. Field names follow Better Auth (`name`, `emailVerified`, `image`)
/// so plugins and the React client see the shapes they expect. Passwords live in `Account.password`.
model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  /// Always stored lower-cased (Better Auth normalises it on sign-up / sign-in).
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  role          UserRole @default(USER)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions           Session[]
  accounts           Account[]
  ownedWorkspaces    Workspace[]             @relation("WorkspaceOwner")
  memberships        WorkspaceMember[]
  impersonationsDone ImpersonationAuditLog[] @relation("ImpersonationAdmin")

  @@map("users")
}

/// Better Auth `session`. Postgres is the source of truth (list/revoke); Redis becomes
/// `secondaryStorage` in SW-T3. `token` is the value inside the signed session cookie.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Better Auth `account`: one row per login method. Email+password uses providerId
/// `credential` and keeps the password hash in `password`.
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

/// Better Auth `verification`: short-lived tokens (email verification, password reset).
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

model Workspace {
  id        String          @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String          @unique
  ownerId   String          @map("owner_id") @db.Uuid
  status    WorkspaceStatus @default(ACTIVE)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner          User                    @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members        WorkspaceMember[]
  impersonations ImpersonationAuditLog[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String              @id @default(uuid(7)) @db.Uuid
  workspaceId String              @map("workspace_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  role        WorkspaceMemberRole @default(MODERATOR)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

/// One row per impersonation token. Only the SHA-256 hash of the token is stored.
model ImpersonationAuditLog {
  id                String    @id @default(uuid(7)) @db.Uuid
  adminId           String    @map("admin_id") @db.Uuid
  targetWorkspaceId String    @map("target_workspace_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt            DateTime? @map("used_at") @db.Timestamptz(3)
  ipAddress         String?   @map("ip_address")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  // Audit rows must outlive deletes: block deleting an admin/workspace that has impersonation history.
  admin           User      @relation("ImpersonationAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  targetWorkspace Workspace @relation(fields: [targetWorkspaceId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([targetWorkspaceId])
  @@map("impersonation_audit_logs")
}
