# Env files per environment (M9-T13b; all git-ignored except this example). Vite's own order, highest first:
#   .env.[mode].local > .env.[mode] > .env.local > .env    mode = development (`npm run dev`) | production (build/preview)
#                                                           | any other with `--mode staging`
# Note: unlike the backend, Vite ranks .env.[mode] above .env.local. Real env vars always win. Keep the same keys in every file.
# The admin app has no build-time env vars: it always calls the API at same-origin /api.
# Dev server only (not inlined into the bundle): where `npm run dev` proxies /api to.
API_PROXY_TARGET=http://localhost:3000
