# Rendered by the nginx image entrypoint (envsubst on ${API_UPSTREAM} / ${NGINX_RESOLVER} only;
# nginx's own $vars are left alone) into /etc/nginx/conf.d/default.conf.
server {
  listen 5173;
  listen [::]:5173;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # Container healthcheck
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Same-origin API (tech-stack.md §4): /api/* goes to the backend with the path unchanged, so the
  # Better Auth cookie is host-only to this origin. A variable upstream + resolver re-resolves the
  # backend's address instead of pinning the IP seen at startup (and nginx starts even if it is down).
  resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
  location /api/ {
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    # Host stays the upstream's own (hosted backends route on it); the browser's host goes in X-Forwarded-Host.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_ssl_server_name on;
    add_header Cache-Control "no-store" always;
  }

  # Hashed build assets: cache for a year
  location /assets/ {
    try_files $uri =404;
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # SPA fallback: unknown paths serve index.html (never cached, so deploys show up at once)
  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache";
  }
}
